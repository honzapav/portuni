    { "method": "PUT", "pattern": "/runners/instances/{id}/org-default", "example": "/runners/instances/01INST/org-default" },
    { "method": "DELETE", "pattern": "/runners/org-defaults/{orgId}", "example": "/runners/org-defaults/01ORG" },
    { "method": "GET", "pattern": "/nodes/{id}/mirror", "example": "/nodes/abc123/mirror" },
    { "method": "POST", "pattern": "/nodes/{id}/mirror", "example": "/nodes/abc123/mirror" },
    { "method": "GET", "pattern": "/nodes/{id}/sync-status", "example": "/nodes/abc123/sync-status?fast=1" },
    { "method": "POST", "pattern": "/nodes/{id}/sync", "example": "/nodes/abc123/sync" },
    { "method": "GET", "pattern": "/nodes/{id}/file", "example": "/nodes/abc123/file?path=wip%2Fa.md" },
