    { "method": "POST", "pattern": "/nodes/{id}/files/{fileId}/move", "example": "/nodes/abc123/files/F1/move" },
    { "method": "POST", "pattern": "/sessions", "example": "/sessions" },
    { "method": "POST", "pattern": "/sessions/{id}/messages", "example": "/sessions/abc123/messages" },
    { "method": "POST", "pattern": "/sessions/{id}/model", "example": "/sessions/abc123/model" },
    { "method": "POST", "pattern": "/sessions/{id}/interrupt", "example": "/sessions/abc123/interrupt" },
    { "method": "POST", "pattern": "/sessions/{id}/continue", "example": "/sessions/abc123/continue" },
    { "method": "POST", "pattern": "/sessions/{id}/close", "example": "/sessions/abc123/close" },
    { "method": "GET", "pattern": "/sessions/{id}/events", "example": "/sessions/abc123/events?after=5" },
