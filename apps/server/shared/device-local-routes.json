  ],
  "sidecar_direct": {
    "$comment": "Served by agent-router.ts but never reached through api_request: the Rust host calls them on the sidecar itself (handoff minting for Showtime, the boot health probe). Not device-local from the webview's point of view.",
    "patterns": ["/health", "/auth/handoff", "/auth/handoff/exchange"]
  }
