<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Hardened-runtime exceptions required by the bun-compiled sidecar
	  (binaries/portuni-sidecar): JavaScriptCore JITs, and the libsql
	  native .node modules in sidecar-deps/ are dlopen()ed at runtime.
	  Tauri signs the app binary and the sidecar with this same file.
	  Reference: bun.sh/docs/bundler/executables (code signing on macOS).
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
