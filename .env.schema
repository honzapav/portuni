# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Turso database connection URL (optional – omit for local SQLite)
# @example=libsql://your-db-name.your-region.turso.io
TURSO_URL=

# Turso database authentication token (required if TURSO_URL is set)
# @sensitive
TURSO_AUTH_TOKEN=

# Root directory for local workspace mirrors
# @required
PORTUNI_WORKSPACE_ROOT="~/Workspaces/portuni"

# Solo user email (Phase 1 single-user mode)
PORTUNI_USER_EMAIL="solo@localhost"

# Solo user display name (Phase 1 single-user mode)
PORTUNI_USER_NAME="Solo User"

# Auth mode: unset/"env" (personal workspace, sync agent, standalone) or
# "google" (the central server). Declared so PORTUNI_AUTH_TOKEN's required
# rule can read it; no default here, the server defaults to env.
# @optional
PORTUNI_AUTH_MODE=

# Bearer token for HTTP/MCP auth in env mode. Every request except the
# public paths (/health, /mcp/info, ...) must present
# "Authorization: Bearer <token>". Required: an env-mode server never starts
# without it. Ignored (one warning at boot) in google mode, which uses
# session JWTs. Set it in the shell that runs varlock (the dev loop reads it
# from the macOS Keychain before `varlock run`); never resolved here.
# @sensitive @required=not(eq($PORTUNI_AUTH_MODE, google))
PORTUNI_AUTH_TOKEN=

# Hardens the env-mode REST write gate's blanket exemption: when set, a
# write needs a matching X-Portuni-Webview-Proxy header (proof it came
# through a trusted proxy -- the desktop app's Tauri host, or this dev
# setup's Vite proxy) or a resolvable X-Portuni-Spawn-Id session; anything
# else is refused instead of falling back to the blanket exemption. Leave
# empty for the legacy behavior (every REST write from an env-mode caller
# allowed, as before this var existed) -- the packaged desktop app always
# sets its own per-launch value regardless of this file. To opt the
# standalone/Vite dev flow into the hardened posture, set the same value
# here and in apps/web's env (both read via varlock).
# @sensitive
PORTUNI_WEBVIEW_PROXY_SECRET=
