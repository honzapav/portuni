# Copy to .sandcastle/.env (gitignored) and fill in the values.

# Claude Code subscription auth — token from the PERSONAL profile (~/.claude):
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub fine-grained PAT scoped to honzapav/portuni:
# Issues (Read and write), Pull requests (Read and write), Contents (Read and write), Metadata (Read)
GH_TOKEN=

# No Turso, Apple, Google or Drive credentials: the agent never reaches
# production. Everything ships through the PR + release flow.
