{
  "project": "portuni",
  "image": "sandcastle:portuni",
  "keychain": {
    "claudeToken": "sandcastle.claude-code.oauth-token",
    "githubToken": "sandcastle.portuni.github-pat",
    "claudeTokens": {
      "osobni": "sandcastle.claude-code.oauth-token",
      "tempo": "sandcastle.claude-code.oauth-token-tempo",
      "jrd": "skill.sandcastle-jrd.claude-oauth-token"
    }
  },
  "model": "claude-opus-5",
  "branchPrefix": "ralph/backlog",
  "maxIterations": 10,
  "maxRuns": 24,
  "idleTimeoutSeconds": 1800,
  "autoCompactWindow": 25,
  "sandboxSetup": [
    "npm ci",
    "npm ci --prefix apps/web",
    "npm ci --prefix sites/docs",
    "scripts/desktop-dev-placeholders.sh"
  ],
  "sandboxEnv": {
    "CARGO_BUILD_JOBS": "2",
    "BASH_DEFAULT_TIMEOUT_MS": "1800000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  },
  "hostPreStart": [],
  "labels": {
    "ready": "ready-for-agent",
    "tracking": "ralph-tracking",
    "humanOnly": "human-only",
    "blocked": "agent-blocked",
    "agent": "agent",
    "closedByAgent": "closed-by-agent"
  },
  "commitPrefix": "RALPH",
  "promptVars": {
    "runtimeTargets": [
      "a local workspace (env auth, no remote)",
      "central mode (desktop as sync agent, PORTUNI_AGENT_MODE=1, everything through the central server)"
    ],
    "lessonsDoc": "docs/lessons-learned.md",
    "evidenceCommands": [
      "npm run qa",
      "npm run test:pglite",
      "cargo test (apps/desktop)"
    ]
  },
  "promptProject": ".sandcastle/prompt.project.md",
  "mainBranch": "main",
  "requireMain": true,
  "review": {
    "profile": "osobni",
    "model": "claude-opus-5",
    "when": "run"
  },
  "telemetry": {
    "endpoint": "https://otlp-gateway-prod-eu-west-2.grafana.net/otlp",
    "headerKeychainService": "skill.grafana-cloud.otlp-auth-header",
    "resourceAttributes": {
      "deployment.environment": "loop-mac"
    },
    "logUserPrompts": false
  },
  "notify": "curl -s -m 8 -H \"Title: sandcastle $SANDCASTLE_PROJECT: $SANDCASTLE_EVENT\" -d \"$SANDCASTLE_MESSAGE\" https://ntfy.sh/sandcastle-honzapav-8159501a >/dev/null"
}
