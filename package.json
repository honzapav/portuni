{
  "name": "portuni",
  "version": "0.21.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx apps/server/index.ts",
    "test": "node --import tsx --test --test-timeout=120000 --test-force-exit test/*.test.ts",
    "test:pglite": "PORTUNI_TEST_DB=pglite node --import tsx --test --test-timeout=120000 --test-force-exit --test-concurrency=2 test/*.test.ts",
    "lint": "biome check",
    "lint:strict": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "gen:resources": "node scripts/gen-mcp-resources.mjs",
    "qa": "npm run lint:strict && npm run typecheck && npm test && npm run build",
    "backup": "varlock run -- node --import tsx scripts/backup-turso.ts",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-push": "npm run qa"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "@electric-sql/pglite": "0.5.8",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.12",
    "opendal": "^0.49.9",
    "pg": "8.23.0",
    "ulid": "^3.0.2",
    "varlock": "^1.19.0",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
