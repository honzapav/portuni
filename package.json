{
  "name": "portuni",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs'),path=require('node:path');const src='apps/server/mcp/resources',dst='dist/mcp/resources';fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src))if(f.endsWith('.md'))fs.copyFileSync(path.join(src,f),path.join(dst,f));\"",
    "start": "node dist/index.js",
    "dev": "tsx apps/server/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "biome check",
    "lint:strict": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "qa": "npm run lint:strict && npm run typecheck && npm test && npm run build",
    "backup": "varlock run -- node --import tsx scripts/backup-turso.ts",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-push": "npm run qa"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.4",
    "opendal": "^0.49.5",
    "ulid": "^3.0.2",
    "varlock": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
